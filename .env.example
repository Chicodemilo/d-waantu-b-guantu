# Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=23847
MYSQL_DATABASE=local_agent_tracker
MYSQL_USER=lat_user
MYSQL_PASSWORD=lat_dev_password
MYSQL_ROOT_PASSWORD=lat_root_password

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
ADMIN_API_KEY=lat-admin-CHANGE-ME-TO-RANDOM-64-CHAR-HEX

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_POLL_ACTIVE_MS=1000

# phpMyAdmin
PMA_PORT=8080

# Jira (optional — leave blank to disable /api/jira/* endpoints)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_CACHE_TTL_SECONDS=60

# Standards auditor (DWB-015 — scripts/run_standards_audit.sh)
# API base the runner POSTs audits to. Falls back to VITE_API_BASE_URL if unset.
STANDARDS_AUDIT_API_BASE=http://localhost:8000/api
# Model the fresh headless auditor runs as (claude -p --model ...).
# Required: set your model id in your local .env (deliberately not shipped here).
STANDARDS_AUDIT_MODEL=
# Optional: attribute the audit POST to a specific agent id (X-Agent-ID).
# Leave blank to log the write as "system".
STANDARDS_AUDIT_AGENT_ID=
